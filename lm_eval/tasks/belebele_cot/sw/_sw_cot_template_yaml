dataset_path: facebook/belebele
dataset_name: swh_Latn
test_split: test
output_type: generate_until
doc_to_text: "Soma kifungu kifuatacho na ujibu swali la chaguo nyingi. Kwenye mstari wa mwisho wa jibu lako, weka herufi ya jibu lako la mwisho ndani ya \\boxed{} (kwa mfano, \\boxed{A}), hakikisha herufi pekee iko ndani. Fikiria hatua kwa hatua kabla ya kujibu.\n\nKifungu: {{flores_passage}}\n\nSwali: {{question.strip()}}\n(A) {{mc_answer1}}\n(B) {{mc_answer2}}\n(C) {{mc_answer3}}\n(D) {{mc_answer4}}"
doc_to_target: !function utils.doc_to_target
filter_list:
  - name: "strict-match"
    filter:
      - function: "regex"
        regex_pattern: "(?<=Jibu ni )(.*)(?=.)"
      - function: "take_first"
  - name: "flexible-extract"
    filter:
      - function: "multi_choice_regex"
        group_select: -1
        ignore_case: true
        ignore_punctuation: true
        regex_pattern: "\\\\boxed\\{([A-D])\\}"
      - function: "take_first"
generation_kwargs:
  until:
    - "</s>"
    - "<|im_end|>"
  do_sample: false
  temperature: 0.0
num_fewshot: 0
metric_list:
  - metric: exact_match
    aggregation: mean
    higher_is_better: true
    ignore_case: true
    ignore_punctuation: true
metadata:
  version: 1.0
